# Settings this site actually reads. Copy this file to .env next to the server
# (server.ts loads it with dotenv), or set the same names in the host's
# environment settings.
#
# This file used to list GEMINI_API_KEY and APP_URL, left over from the AI Studio
# template. Nothing in the code reads either, and a Gemini key must never be
# given to this site: anything built into the browser bundle is public.

# --- server (dist/server.cjs) -------------------------------------------------

# Where the contact form delivers each enquiry, as a JSON POST. Point it at any
# service that turns a webhook into an email. Without it the form fails honestly
# and offers the patient a pre-written email instead. Keep it private: anyone who
# has the URL can post to it.
CONTACT_WEBHOOK_URL=

# The port the server listens on. Hosts usually set this themselves.
PORT=3000

# "production" on the host. Anything else starts the development server.
NODE_ENV=production

# --- build (npm run build) ----------------------------------------------------

# Overrides the address written into sitemap.xml and robots.txt. Leave unset to
# use CLINIC.website from src/data/clinic.ts.
# SITE_URL=

# LIVE is set for you by `npm run build:live`. Don't set it by hand.
